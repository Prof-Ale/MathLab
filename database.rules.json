{
  "rules": {
    ".read": false,
    ".write": false,
    "anfitrioes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$codigo": {
          ".validate": "$codigo.matches(/^[0-9]{6}$/) && newData.isNumber()"
        }
      }
    },
    "salas": {
      "$codigo": {
        ".validate": "$codigo.matches(/^[0-9]{6}$/)",
        ".read": "auth != null && data.child('hostUid').val() === auth.uid",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || (data.exists() && data.child('hostUid').val() === auth.uid && !newData.exists()))",
        "hostUid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "hostOnline": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('salas').child($codigo).child('hostUid').val() === auth.uid",
          ".validate": "newData.isBoolean()"
        },
        "criadaEm": {
          ".validate": "newData.isNumber()"
        },
        "estado": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('salas').child($codigo).child('hostUid').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|questao|resultado|podio)$/)"
        },
        "cfg": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('salas').child($codigo).child('hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['total','tempo','bonus'])",
          "total": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"
          },
          "tempo": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120"
          },
          "bonus": {
            ".validate": "newData.isBoolean()"
          },
          "trancada": {
            ".validate": "newData.isBoolean()"
          },
          "$outro": {
            ".validate": false
          }
        },
        "rodada": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('salas').child($codigo).child('hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['qi','q','o','inicioEm','tempoSeg','mod'])",
          "qi": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "mod": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "ic": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "nivel": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
          },
          "fig": {
            ".validate": "newData.isBoolean()"
          },
          "eixo": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "q": {
            ".validate": "newData.isString() && newData.val().length <= 700"
          },
          "o": {
            ".validate": "newData.hasChildren() && newData.val() !== null",
            "$i": {
              ".validate": "$i.matches(/^[0-3]$/) && newData.isString() && newData.val().length <= 240"
            }
          },
          "inicioEm": {
            ".validate": "newData.isNumber()"
          },
          "tempoSeg": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120"
          },
          "$outro": {
            ".validate": false
          }
        },
        "revelacao": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('salas').child($codigo).child('hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['qi','correta'])",
          "qi": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "correta": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
          },
          "explicacao": {
            ".validate": "newData.isString() && newData.val().length <= 900"
          },
          "$outro": {
            ".validate": false
          }
        },
        "jogadores": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('salas').child($codigo).child('hostUid').val() === auth.uid && !newData.exists()",
            ".validate": "newData.hasChildren(['apelido'])",
            "apelido": {
              ".write": "auth != null && auth.uid === $uid && (data.exists() || root.child('salas').child($codigo).child('cfg').child('trancada').val() !== true)",
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 20"
            },
            "online": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isBoolean()"
            },
            "pts": {
              ".write": "auth != null && root.child('salas').child($codigo).child('hostUid').val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "acertos": {
              ".write": "auth != null && root.child('salas').child($codigo).child('hostUid').val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "seq": {
              ".write": "auth != null && root.child('salas').child($codigo).child('hostUid').val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "maxSeq": {
              ".write": "auth != null && root.child('salas').child($codigo).child('hostUid').val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "somaTempo": {
              ".write": "auth != null && root.child('salas').child($codigo).child('hostUid').val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "pos": {
              ".write": "auth != null && root.child('salas').child($codigo).child('hostUid').val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 200"
            },
            "ult": {
              ".write": "auth != null && root.child('salas').child($codigo).child('hostUid').val() === auth.uid",
              ".validate": "newData.isBoolean()"
            },
            "$outro": {
              ".validate": false
            }
          }
        },
        "respostas": {
          ".write": "auth != null && root.child('salas').child($codigo).child('hostUid').val() === auth.uid && !newData.exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('salas').child($codigo).child('estado').val() === 'questao' && root.child('salas').child($codigo).child('jogadores').child($uid).exists() && (root.child('salas').child($codigo).child('rodada').child('tempoSeg').val() == 0 || now <= root.child('salas').child($codigo).child('rodada').child('inicioEm').val() + root.child('salas').child($codigo).child('rodada').child('tempoSeg').val() * 1000 + 3000)",
            ".validate": "newData.hasChildren(['op','t','qi']) && newData.child('qi').val() === root.child('salas').child($codigo).child('rodada').child('qi').val()",
            "op": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3 && newData.val() % 1 === 0"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "qi": {
              ".validate": "newData.isNumber()"
            },
            "$outro": {
              ".validate": false
            }
          }
        },
        "$outro": {
          ".validate": false
        }
      }
    }
  }
}
